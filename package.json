{
  "name": "hunterr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "description": "Phase 1 Chrome Extension for an AI-powered job application assistant.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
